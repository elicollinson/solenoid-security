{
  "schemaVersion": "security-eval-suite/v1",
  "id": "prompt-injection-armor-score-counterfactual-v1",
  "tests": [
    {
      "id": "paper-score-counterfactual",
      "datasetId": "longpibench-paper-score-counterfactual-v1",
      "datasetRevision": "sha256:4444b2de79a4631149f98da506534a50884b6d5158de2f255a81f2c370325dd4",
      "annotationKey": "prompt_injection_attempt",
      "caseSelector": "all",
      "metrics": [
        "detection_rate",
        "false_positive_rate",
        "confusion_matrix"
      ]
    }
  ],
  "engines": {
    "armor-low": {
      "id": "model-armor-low-intensity",
      "kind": "model_armor",
      "projectId": "${MODEL_ARMOR_PROJECT_ID}",
      "location": "${MODEL_ARMOR_LOCATION}",
      "templateId": "low-intensity",
      "filter": "pi_and_jailbreak"
    },
    "armor-base": {
      "id": "model-armor-base-detector",
      "kind": "model_armor",
      "projectId": "${MODEL_ARMOR_PROJECT_ID}",
      "location": "${MODEL_ARMOR_LOCATION}",
      "templateId": "base-detector",
      "filter": "pi_and_jailbreak"
    },
    "armor-high": {
      "id": "model-armor-high-sensitivity",
      "kind": "model_armor",
      "projectId": "${MODEL_ARMOR_PROJECT_ID}",
      "location": "${MODEL_ARMOR_LOCATION}",
      "templateId": "high-sensitivity",
      "filter": "pi_and_jailbreak"
    }
  },
  "inputStrategies": {
    "full": {
      "id": "last-external-source-v1",
      "kind": "full_text",
      "turnSelection": "last_external"
    },
    "windows512": {
      "id": "last-external-sliding-w512-s384-v1",
      "kind": "sliding_word_window",
      "windowWords": 512,
      "strideWords": 384,
      "turnSelection": "last_external"
    },
    "preserve512": {
      "id": "sliding-preserve-words-512-stride384-v1",
      "kind": "sliding_word_window_preserve_v1",
      "windowWords": 512,
      "strideWords": 384,
      "turnSelection": "last_external"
    }
  },
  "decisionRules": {
    "armorPi": {
      "id": "pi-match-any",
      "kind": "binary_verdict",
      "aggregation": "any",
      "positiveVerdict": "MATCH_FOUND"
    }
  },
  "conditions": [
    {
      "id": "armor-low-full",
      "engine": "armor-low",
      "inputStrategy": "full",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-low-windows512",
      "engine": "armor-low",
      "inputStrategy": "windows512",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-low-preserve512",
      "engine": "armor-low",
      "inputStrategy": "preserve512",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-base-full",
      "engine": "armor-base",
      "inputStrategy": "full",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-base-windows512",
      "engine": "armor-base",
      "inputStrategy": "windows512",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-base-preserve512",
      "engine": "armor-base",
      "inputStrategy": "preserve512",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-high-full",
      "engine": "armor-high",
      "inputStrategy": "full",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-high-windows512",
      "engine": "armor-high",
      "inputStrategy": "windows512",
      "decisionRule": "armorPi",
      "repeat": 1
    },
    {
      "id": "armor-high-preserve512",
      "engine": "armor-high",
      "inputStrategy": "preserve512",
      "decisionRule": "armorPi",
      "repeat": 1
    }
  ]
}
