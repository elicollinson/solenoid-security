  "engines": {
    "llada22-flash-4bit": {
      "id": "llada22-flash-4bitmlx-openai-compat-score-v1-promptjson-t128-s32-v1",
      "kind": "llm_score_json",
      "model": "LLaDA2.2-flash",
      "provider": "openai_compatible",
      "promptId": "security-eval-score-only-json-v1",
      "promptSha256": "f194db14605133e23fc4871659c89e7ac155452468d5e69d526f105138617d36",
      "schemaId": "concern-score-only-json-v1",
      "parameters": {
        "temperature": 0,
        "max_tokens": 128
      },
      "openaiCompatible": {
        "baseUrl": "http://127.0.0.1:8088/v1",
        "runtime": "MLX port, user-provided server on Mac Studio",
        "origin": "Mac Studio, reached via a local port forward unless overridden at run time (the URL actually used is recorded per request)",
        "quantization": "4-bit MLX",
        "weights": "User's own MLX 4-bit build of the official inclusionAI/LLaDA2.2-flash weights",
        "timeoutMs": 600000,
        "responseFormat": "prompt_json",
        "decoding": {
          "block_length": 32,
          "steps": 32,
          "threshold": 0.5,
          "editing_threshold": 0,
          "max_post_steps": 16
        },
        "sendDecodingParams": true,
        "decodingNote": "Full LLaDA2.2 decoder ported to MLX with editing on (token rewrite, DELETE and INSERT; editing_threshold 0.0). Decoding params are sent per request and pinned here; block_length 32 is fixed by the model (the server rejects other values). temperature 0 and max_tokens 128 (output length) are sent as standard parameters. The server accepts but ignores response_format, so the frozen prompt alone requests JSON; logprobs are unsupported. Disabled: no condition uses this engine yet; confirm that the flash model accepts the same decoding (block_length in particular) before adding one."
      }
    }
  },
